{
  "github": {
    "api_url": "https://api.github.com",
    "app_client_id": "",
    "private_key_path": ".pem"
  },
  "input": {
    "repos_csv": "./repos.csv",
    "audit_log_csv": null
  },
  "output": {
    "directory": "./reports",
    "file_prefix": "github_user_activity"
  },
  "report": {
    "lookback_days": 365,
    "active_min_days": 8,
    "moderate_min_days": 3,
    "include_archived_repos": false,
    "include_forked_repos": true,
    "exclude_bots": true,
    "include_inactive_org_members": true,
    "include_runner_metrics": true,
    "max_runner_runs_per_repo": 50
  },
  "runtime": {
    "max_workers": 4,
    "request_timeout_seconds": 30,
    "max_retries": 5,
    "rate_limit_buffer": 25,
    "inter_request_delay_seconds": 0.05,
    "log_level": "INFO"
  }
}
